{
  "manifest_version": 3,
  "name": "Yazım Denetçi (AloTech)",
  "version": "1.4",
  "description": "AloTech panelinde büyük harf, noktalama ve yazım yanlışı düzeltir.",
  "content_scripts": [
    {
      "matches": [
        "https://protel.alo-tech.com/*"
      ],
      "js": ["shim.js", "deasciifier.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}